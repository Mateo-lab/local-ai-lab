      "name": "Garde-fous",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst MAX_LOT = 1000;   // sécurité : refuse un lot anormalement gros\nconst libelles = $('Lister les libellés').all().map(i => i.json);\nconst l = libelles.find(x => x.name === \"IA/Supprimer\");\nif (!l) throw new Error(\"Libellé « IA/Supprimer» introuvable.\");\nconst mails = $input.all().map(i => i.json).filter(m => m && m.id);\nif (mails.length > MAX_LOT) throw new Error(`${mails.length} mails portent le libellé : au-delà de ${MAX_LOT}, vérifie dans Gmail avant de continuer.`);\nreturn mails.filter(m => !(m.labelIds || []).some(x => x === \"STARRED\")).map(m => ({ json: { id: m.id, libelleId: l.id } }));"
      }
    },
    {
      "id": "9a50ea01-b1bc-4d72-abdf-ef15754a1000",
      "name": "Retirer le libellé Supprimer",
