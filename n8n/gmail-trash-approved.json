      "name": "Safeguards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst MAX_BATCH = 1000;   // safety: refuses an abnormally large batch\nconst labels = $('List labels').all().map(i => i.json);\nconst l = labels.find(x => x.name === \"AI/Delete\");\nif (!l) throw new Error(\"Label \\\"AI/Delete\\\" not found.\");\nconst messages = $input.all().map(i => i.json).filter(m => m && m.id);\nif (messages.length > MAX_BATCH) throw new Error(`${messages.length} messages carry the label: above ${MAX_BATCH}, check in Gmail before continuing.`);\nreturn messages.filter(m => !(m.labelIds || []).some(x => x === \"STARRED\")).map(m => ({ json: { id: m.id, labelId: l.id } }));"
      }
    },
    {
