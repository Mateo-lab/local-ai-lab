cmd_logs() { need docker; local s="${1:?usage : lab logs SERVICE [lignes]}"; docker logs -f --tail "${2:-100}" "$s"; }

cmd_models() { need docker; echo "Installés :"; docker exec ollama ollama list; echo; echo "Chargés en VRAM :"; docker exec ollama ollama ps; }

cmd_task_model() {
  need docker; local m="${1:?usage : lab task-model NOM   (un modèle de 1 à 4 milliards de paramètres)}"
  echo "→ téléchargement de $m"; docker exec ollama ollama pull "$m" || die "téléchargement impossible : nom de modèle exact ?"
  env_set "$ROOT/ai-stack/.env" OLLAMA_MAX_LOADED_MODELS 2
  env_set "$ROOT/ai-stack/.env" OWUI_TASK_MODEL "$m"
  echo "→ redémarrage d'Ollama et d'Open WebUI (le modèle en mémoire sera rechargé au prochain message)"
  dc ai-stack up -d ollama open-webui
  cat <<MSG
$c_ok ai-stack/.env mis à jour (OLLAMA_MAX_LOADED_MODELS=2, OWUI_TASK_MODEL=$m).
À FAIRE dans Open WebUI (les réglages existants sont gardés en base) :
  Admin → Paramètres → Interface → Modèle de tâches → $m
Vérifier ensuite : docker exec ollama ollama ps   (deux lignes, tout en 100% GPU)
MSG
}

cfg_get() { [ -f "$STATE/config" ] && awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$STATE/config"; }
cfg_set() { mkdir -p "$STATE"; env_set "$STATE/config" "$1" "$2"; }

# Modèle principal : LAB_MODEL, sinon `lab config set MODEL …`, sinon le PLUS GROS modèle installé (hors embeddings et hors
# petit modèle de tâches d'Open WebUI). Le premier de `ollama list` est souvent ce petit modèle : ne pas s'y fier.
main_model() {
  [ -n "${LAB_MODEL:-}" ] && { echo "$LAB_MODEL"; return; }
  local c; c="$(cfg_get MODEL)"; [ -n "$c" ] && { echo "$c"; return; }
  local task; task="$(awk -F= '$1=="OWUI_TASK_MODEL"{print $2}' "$ROOT/ai-stack/.env" 2>/dev/null)"
  docker exec ollama ollama list 2>/dev/null | awk -v task="${task:-__aucun__}" 'NR>1 && $1 !~ /embed|nomic/ && $1 != task {
      u=$4; v=$3+0; if (u=="GB") v*=1024; else if (u=="KB") v/=1024; else if (u!="MB") next; print v, ($1 ~ /-64k$/ ? 1 : 0), $1 }' \
    | sort -k1,1nr -k2,2nr | head -1 | awk '{print $3}'
}
default_model() { main_model; }

cmd_config() { # lab config [list | get CLE | set CLE VALEUR | unset CLE]
  local a="${1:-list}"; mkdir -p "$STATE"
  case "$a" in
    list) echo "Réglages mémorisés (.lab/config) :"; [ -s "$STATE/config" ] && sed 's/^/  /' "$STATE/config" || echo "  (aucun)"
          echo "Modèle principal utilisé aujourd'hui : $(main_model)  (LAB_MODEL puis réglage MODEL puis plus gros modèle installé)" ;;
    get)  cfg_get "${2:?usage : lab config get CLE}" ;;
    set)  local k="${2:?usage : lab config set MODEL NOM_DU_MODELE}" v="${3:?valeur manquante}"
          case "$k" in MODEL) docker exec ollama ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$v" \
                               || die "modèle « $v » absent d'Ollama (lab models)";; *) die "réglage inconnu : $k (MODEL)";; esac
          cfg_set "$k" "$v"; echo "$c_ok $k=$v mémorisé. Utilisé par lab bench, lab dev start… (Open WebUI garde son propre modèle par défaut : à régler dans son interface)" ;;
    unset) [ -f "$STATE/config" ] && sed -i "/^${2:?usage : lab config unset CLE}=/d" "$STATE/config"; echo "$c_ok ${2} retiré" ;;
    *) die "usage : lab config list|get CLE|set MODEL NOM|unset CLE" ;;
  esac
}

# Lance une action longue dans une session tmux nommée (survit à une coupure SSH ; se rattache si elle existe déjà).
cmd_tmux() {
  local a="${1:?usage : lab tmux update|backup|doctor}"; need tmux
  case "$a" in update|backup|doctor) ;; *) die "action inconnue : $a (update backup doctor)";; esac
  local arg="" ; [ "$a" = backup ] && arg=" run"
  exec tmux new-session -A -s "lab-$a" "$SELF $a$arg; echo; read -r -p 'Terminé. Appuie sur Entrée pour fermer. ' _"
}

cmd_bench() {
  if [ $# -eq 0 ]; then exec "$ROOT/7-bench.sh" list; fi
  local name="$1"; shift
  case "$name" in check|list|report) exec "$ROOT/7-bench.sh" "$name" "$@" ;; esac
  local has=""; for a in "$@"; do [ "$a" = "--model" ] && has=set; done
  if [ -z "$has" ]; then
    local m; m="$(default_model)"; [ -n "$m" ] || die "aucun modèle trouvé : précise --model NOM ou exporte LAB_MODEL"
    echo "Modèle : $m  (change avec --model NOM ou LAB_MODEL=NOM)"
    set -- --model "$m" "$@"
  fi
  exec "$ROOT/7-bench.sh" run "$name" "$@"
}

# Panneau web (boutons) : service systemd utilisateur, écoute 127.0.0.1:3011 seulement.
cmd_panel() {
  local unit="$HOME/.config/systemd/user/aibeast-panel.service" tokf="$HOME/.config/aibeast-panel/token"
  case "${1:-status}" in
    install)
      need systemctl; need python3
      mkdir -p "$(dirname "$unit")"
      cat > "$unit" <<UNIT
[Unit]
Description=Panneau AiBeast (boutons)

[Service]
ExecStart=/usr/bin/env python3 $ROOT/panel/panel.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
      systemctl --user daemon-reload && systemctl --user enable --now aibeast-panel.service
      loginctl enable-linger "$USER" 2>/dev/null || echo "$c_wa linger non activé : le panneau ne démarrera qu'après ta première connexion (sudo loginctl enable-linger $USER)"
      sleep 1; cmd_panel token ;;
    token)
      [ -f "$tokf" ] || die "pas de jeton : lab panel install"
      echo "Ouvre cette adresse une fois dans le navigateur de ton PC (tunnel SSH actif) :"
      echo "  http://127.0.0.1:3011/login?t=$(cat "$tokf")" ;;
    status) systemctl --user is-active aibeast-panel.service 2>&1 || true ;;
    logs) exec journalctl --user -u aibeast-panel.service -n "${2:-50}" --no-pager ;;
    restart) systemctl --user restart aibeast-panel.service && echo "$c_ok redémarré" ;;
    uninstall) systemctl --user disable --now aibeast-panel.service 2>/dev/null; rm -f "$unit"; systemctl --user daemon-reload; echo "$c_ok désinstallé (le jeton reste dans $tokf)" ;;
    *) die "usage : lab panel install|token|status|logs|restart|uninstall" ;;
  esac
}

cmd_dev() { exec "$ROOT/scripts/dev.sh" "$@"; }
cmd_remote() { exec "$ROOT/scripts/remote.sh" "$@"; }
cmd_gpu_limit() { [ $# -eq 0 ] && set -- status; exec "$ROOT/scripts/gpu-power-limit.sh" "$@"; }
cmd_backup()    { exec "$ROOT/scripts/backup.sh" "$@"; }
cmd_client()    { exec "$ROOT/scripts/client-config.sh" "$@"; }
cmd_isolation() { exec "$ROOT/scripts/isolation-agents.sh" "$@"; }

cmd_bureau() {
  local act="${1:-status}"; shift || true; local boot=0; [ "${1:-}" = "--boot" ] && boot=1
  local U=gnome-remote-desktop.service
  case "$act" in
    status)
      echo "service système : $(systemctl is-active $U 2>/dev/null)  (au démarrage : $(systemctl is-enabled $U 2>/dev/null))"
      echo "service utilisateur : $(systemctl --user is-active $U 2>/dev/null)"
      command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=pstate,power.draw --format=csv,noheader | sed 's/^/GPU : /' ;;
    off)
      if [ -z "${SSH_CONNECTION:-}" ]; then
        echo "$c_wa Tu ne sembles pas être dans une session SSH. Si tu es DANS le bureau à distance, il va se couper."
        read -r -p "Continuer ? [o/N] " r; [[ "$r" =~ ^[oOyY]$ ]] || exit 1
      fi
      sudo systemctl stop $U && echo "$c_ok bureau à distance arrêté (le GPU redescend en P8 en ≈ 20 s)"
      if [ $boot = 1 ]; then sudo systemctl disable $U && echo "$c_ok ne démarrera plus au boot"; fi ;;
    on)
      sudo systemctl start $U && echo "$c_ok bureau à distance démarré (≈ +100 W au repos)"
      if [ $boot = 1 ]; then sudo systemctl enable $U && echo "$c_ok démarrera au boot"; fi ;;
    *) die "usage : lab bureau on|off|status [--boot]" ;;
  esac
}

cmd_doctor() {
  need docker; local bad=0 warn=0
  ok() { echo "$c_ok $*"; }
  ko() { echo "$c_ko $*"; bad=$((bad+1)); }
  wa() { echo "$c_wa $*"; warn=$((warn+1)); }

  systemctl is-active --quiet docker && ok "Docker actif" || ko "Docker inactif (sudo systemctl start docker)"
  local root; root="$(docker info -f '{{.DockerRootDir}}' 2>/dev/null)"
  case "$root" in "$LAB_DATA_DIR"/*) ok "Docker stocke ses données sur $root" ;; *) wa "Docker stocke sur $root (attendu : $LAB_DATA_DIR/docker, voir ./8-stockage.sh)" ;; esac
  if mountpoint -q "$LAB_DATA_DIR"; then ok "$LAB_DATA_DIR monté"
  elif [ -d "$LAB_DATA_DIR" ] && [ "${LAB_DATA_DIR}" != /data ]; then wa "$LAB_DATA_DIR n'est pas un disque séparé (normal sur une machine à un seul disque)"
  else ko "$LAB_DATA_DIR NON monté (disque de données absent ? voir LAB_DATA_DIR dans lab.conf)"; fi

  local missing=() running expected=() mode; running="$(docker ps --format '{{.Names}}')"; mode="$(current_mode)"
  for c in "${EXPECTED[@]}"; do
    if [ "$mode" = agents ] && [[ " ${AGENT_PAUSE[*]} " == *" $c "* ]]; then continue; fi
    expected+=("$c")
  done
  for c in "${expected[@]}"; do grep -qx "$c" <<<"$running" || missing+=("$c"); done
  if [ ${#missing[@]} -eq 0 ]; then ok "${#expected[@]} conteneurs attendus en marche (mode : $mode)"; else ko "arrêtés ou absents : ${missing[*]}"; fi
  if [ -f "$ROOT/langfuse/app/docker-compose.yml" ]; then
    if [ -n "$(docker ps -q --filter label=com.docker.compose.service=langfuse-web)" ]; then ok "Langfuse en marche"; else ko "Langfuse installé mais arrêté (lab start langfuse)"; fi
  fi
  local unh; unh="$(docker ps --filter health=unhealthy --format '{{.Names}}')"
  if [ -z "$unh" ]; then ok "aucun conteneur « unhealthy »"; else ko "unhealthy : $unh"; fi

  if command -v nvidia-smi >/dev/null; then
    local pl ps pw tp
    IFS=, read -r pl ps pw tp < <(nvidia-smi --query-gpu=power.limit,pstate,power.draw,temperature.gpu --format=csv,noheader,nounits)
    ps="${ps// /}"; pw="${pw// /}"
    ok "GPU : limite ${pl} W, $ps, $pw W, ${tp// /} °C"
    if [ "$ps" = P2 ] && awk "BEGIN{exit !($pw>80)}"; then
      # pas d'alerte si ComfyUI tourne : une génération d'image explique P2 et la consommation
      [ -n "$(docker ps -q -f 'name=^comfyui$')" ] || docker exec ollama ollama ps 2>/dev/null | awk 'NR>1' | grep -q . || wa "GPU en P2 à $pw W sans modèle chargé : bureau à distance actif ? (lab bureau off)"
    fi
  else wa "nvidia-smi introuvable"; fi
  if systemctl is-active --quiet gnome-remote-desktop.service; then wa "bureau à distance actif (≈ +100 W au repos)"; else ok "bureau à distance éteint"; fi

  for m in / "$LAB_DATA_DIR"; do
    local u; u="$(df --output=pcent "$m" 2>/dev/null | tail -1 | tr -dc 0-9)"
    [ -z "$u" ] && continue
    if [ "$u" -lt 85 ]; then ok "disque $m : $u %"; else wa "disque $m : $u % (> 85 %)"; fi
  done

  local op; op="$(docker exec ollama ollama ps 2>/dev/null | awk 'NR>1')"
  if [ -n "$op" ]; then
    if grep -q 'CPU' <<<"$op"; then wa "un modèle déborde sur le CPU (voir : docker exec ollama ollama ps)"; else ok "modèle(s) chargé(s) 100 % GPU"; fi
  fi

  # Isolation des agents (docs/isolation-agents.md)
  local nint=0 n; for n in llm-net hermes-net obs-net; do [ "$(docker network inspect -f '{{.Internal}}' "$n" 2>/dev/null)" = true ] && nint=$((nint+1)); done
  [ "$nint" = 3 ] && ok "réseaux des agents internes (llm-net, hermes-net, obs-net)" || ko "réseaux des agents : $nint/3 internes (agents avec accès Internet ; voir docs/isolation-agents.md)"
  if systemctl is-active --quiet ai-lab-isolation.service; then ok "pare-feu des agents actif (lab isolation status)"
  else wa "pare-feu des agents inactif : Hermes et OpenClaw peuvent sortir (lab isolation install)"; fi
  if command -v restic >/dev/null && [ -f "${BACKUP_PASSWORD_FILE:-$HOME/.config/aibeast-backup/password}" ]; then
    local l; if l="$("$ROOT/scripts/backup.sh" last 2>/dev/null)"; then ok "dernière sauvegarde : $l"; else wa "dernière sauvegarde : ${l:-introuvable} (lab backup run)"; fi
  else wa "sauvegardes non configurées (lab backup init)"; fi

  echo
  if [ $bad -eq 0 ]; then echo "Résultat : tout est bon ($warn remarque(s))."; else echo "Résultat : $bad problème(s), $warn remarque(s)."; fi
  [ $bad -eq 0 ]
}

snapshot_images() { # écrit « projet<TAB>référence<TAB>id » pour chaque conteneur en marche
  local f="$1"; : > "$f"
  for p in "${PROJECTS[@]}"; do
    docker ps --filter "label=com.docker.compose.project=$(basename "$(pdir "$p")")" --format '{{.Names}}' | while read -r n; do
      docker inspect -f '{{.Config.Image}}{{"\t"}}{{.Image}}' "$n" | awk -v p="$p" '{print p"\t"$0}'
    done
  done >> "$f"
}

cmd_update() {
  need docker; local nobackup=0; [ "${1:-}" = "--no-backup" ] && nobackup=1
  mkdir -p "$STATE"; local snap; snap="$STATE/images-$(date +%Y%m%d-%H%M%S).tsv"
  if [ $nobackup = 0 ] && command -v restic >/dev/null && [ -f "${BACKUP_PASSWORD_FILE:-$HOME/.config/aibeast-backup/password}" ]; then
    echo "→ sauvegarde avant mise à jour"; "$ROOT/scripts/backup.sh" run || die "sauvegarde en échec : mise à jour annulée (--no-backup pour passer outre)"
  else echo "$c_wa pas de sauvegarde avant mise à jour (non configurée ou --no-backup)"; fi
  snapshot_images "$snap"; ln -sf "$snap" "$STATE/latest.tsv"
  echo "$c_ok images actuelles mémorisées : $snap ($(wc -l <"$snap") conteneurs)"
  for p in "${PROJECTS[@]}"; do echo "→ pull $p"; dc "$p" pull --quiet || echo "$c_wa pull partiel pour $p"; done
  for p in "${PROJECTS[@]}"; do echo "→ up $p"; dc "$p" up -d; done
  apply_mode
  echo "→ attente 30 s puis contrôle"; sleep 30
  local changed=0 p ref old now
  while IFS=$'\t' read -r p ref old; do
    now="$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null)"
    if [ -n "$now" ] && [ "$now" != "$old" ]; then echo "  mis à jour : $ref"; changed=$((changed+1)); fi
  done < "$snap"
  echo "$changed image(s) changée(s)."
  if ! cmd_doctor; then echo; echo "Problème détecté. Pour revenir en arrière : lab rollback"; exit 1; fi
  echo "Garde les anciennes images jusqu'à être sûr : ne lance pas « docker image prune » avant."
}

cmd_rollback() {
  need docker; local snap="$STATE/latest.tsv"; [ -f "$snap" ] || die "aucune mise à jour mémorisée ($STATE/latest.tsv)"
  echo "Retour aux images de : $(readlink -f "$snap")"
  local lost=0 p ref id
  while IFS=$'\t' read -r p ref id; do
    if docker image inspect "$id" >/dev/null 2>&1; then docker tag "$id" "$ref"; echo "  $ref ← ${id:7:12}"
    else echo "  $c_ko image $ref ${id:7:12} supprimée : impossible de revenir"; lost=$((lost+1)); fi
  done < "$snap"
  for p in "${PROJECTS[@]}"; do dc "$p" up -d; done
  apply_mode
  [ $lost -gt 0 ] && echo "$c_wa $lost image(s) introuvable(s) (prune ?) : voir docs/lab.md"
  echo "Les données (volumes) ne sont pas touchées par un retour d'image. Si une base a migré vers un format plus récent, restaure-la : docs/sauvegardes.md"
  cmd_doctor
}

c="${1:-help}"; shift || true
case "$c" in
  install) cmd_install ;;    start) cmd_start "$@" ;;      stop) cmd_stop "$@" ;;
  status) cmd_status ;;      doctor) cmd_doctor ;;         logs) cmd_logs "$@" ;;
  urls) cmd_urls ;;          models) cmd_models ;;         task-model) cmd_task_model "$@" ;;
  bench) cmd_bench "$@" ;;   gpu-limit) cmd_gpu_limit "$@" ;;  bureau) cmd_bureau "$@" ;;
  backup) cmd_backup "$@" ;; update) cmd_update "$@" ;;    rollback) cmd_rollback ;;
  mode) cmd_mode "$@" ;;     panel) cmd_panel "$@" ;;     remote) cmd_remote "$@" ;;     dev) cmd_dev "$@" ;;     config) cmd_config "$@" ;;
  tmux) cmd_tmux "$@" ;;     main-model) main_model ;;  client) cmd_client "$@" ;;  isolation) cmd_isolation "$@" ;;
  help|-h|--help|"") sed -n '2,26p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) echo "lab : commande inconnue « $c »" >&2; sed -n '2,26p' "$SELF" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
