#!/usr/bin/env bash
# lab : une seule commande pour piloter AiBeast. Voir docs/lab.md.
#
#   lab install                    crée la commande `lab` (lien dans ~/.local/bin)
#   lab status                     conteneurs, GPU, disques
#   lab doctor                     contrôle de santé complet (à lancer après un redémarrage)
#   lab start [projet]             démarre tout, dans l'ordre (ou un seul : ai-stack monitoring portail alerting comfyui langfuse)
#   lab stop [projet]              arrête (ne supprime rien)
#   lab logs SERVICE [n]           journaux d'un conteneur (suivi en direct)
#   lab urls                       adresses des interfaces
#   lab models                     modèles installés et chargés
#   lab task-model NOM             installe un petit modèle pour les titres Open WebUI
#   lab bench [expérience] [...]   banc d'essai (sans argument : liste)
#   lab gpu-limit status|install [W]|remove    limite de puissance GPU permanente
#   lab bureau on|off|status [--boot]          bureau à distance (≈ 100 W)
#   lab client [--print]           génère la config SSH (tunnels + bureau à distance) du PC client depuis lab.conf : docs/acces-distant.md
#   lab isolation install|apply|status|test|remove|uninstall   coupe Internet aux agents (Hermes, OpenClaw) : docs/isolation-agents.md
#   lab backup init|run|list|check|restore|schedule    sauvegardes chiffrées
#   lab update [--no-backup]       met à jour les images, mémorise les anciennes
#   lab rollback                   revient aux images d'avant la dernière mise à jour
#   lab mode agents|images|normal|status   agents : libère la VRAM pour les agents (arrête ComfyUI, Kokoro, Tika)
#                                          images : décharge les modèles Ollama et lance ComfyUI ; normal : rétablit
#   lab config [list|set MODEL NOM]   modèle principal mémorisé ; `lab tmux update|backup|doctor` : action longue qui survit à une coupure
#   lab panel install|token|status|logs|uninstall   panneau web à boutons (127.0.0.1:3011) : docs/panneau-web.md
#   lab remote add|show|link|list|test|remove   accès SSH de Hermes à une machine de test (clé dédiée) : docs/hermes-ssh.md
#   lab dev new|list|start|review|check|merge|setup|ctx64   développement avec Hermes (code → test → review) : docs/developpement-agents.md
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$SELF")"
STATE="$ROOT/.lab"

# Configuration propre à la machine (facultative) : voir lab.conf.example
[ -f "$ROOT/lab.conf" ] && . "$ROOT/lab.conf"
LAB_DATA_DIR="${LAB_DATA_DIR:-/data}"   # gros volumes : Docker, sauvegardes, modèles
export LAB_DATA_DIR
PROJECTS=(ai-stack monitoring portail alerting)           # ordre de démarrage
[ -f "$ROOT/langfuse/app/docker-compose.yml" ] && PROJECTS+=(langfuse)   # seulement si installé (./6-langfuse.sh)
AGENT_PAUSE=(comfyui kokoro tika)    # arrêtés par `lab mode agents` (aucun n'est utile aux agents ; ComfyUI prend de la VRAM)
EXPECTED=(ollama open-webui n8n qdrant postgres-n8n searxng kokoro tika
          prometheus grafana node-exporter gpu-exporter
          homepage ntfy alertmanager alertmanager-ntfy blackbox-exporter)

c_ok=$'\e[32m✓\e[0m'; c_ko=$'\e[31m✗\e[0m'; c_wa=$'\e[33m!\e[0m'
die()  { echo "lab : $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "il manque '$1'"; }

pdir() { # pdir PROJET -> dossier du compose
  case "$1" in
    langfuse) echo "$ROOT/langfuse/app" ;;
    ai-stack|monitoring|portail|alerting|comfyui|hermes) echo "$ROOT/$1" ;;
    *) die "projet inconnu : $1 (ai-stack monitoring portail alerting comfyui langfuse)" ;;
  esac
}
dc() { local p="$1"; shift; local d; d="$(pdir "$p")"; [ -d "$d" ] || die "dossier absent : $d"; (cd "$d" && docker compose "$@"); }

env_set() { # env_set FICHIER CLE VALEUR : remplace ou ajoute CLE=VALEUR sans toucher au reste
  python3 - "$1" "$2" "$3" <<'PY'
import sys,re
f,k,v=sys.argv[1:4]
try: lines=open(f).read().splitlines()
except FileNotFoundError: lines=[]
out=[];done=False
for l in lines:
    if re.match(rf"^\s*{re.escape(k)}\s*=",l): out.append(f"{k}={v}"); done=True
    else: out.append(l)
if not done: out.append(f"{k}={v}")
open(f,"w").write("\n".join(out)+"\n")
PY
}

cmd_install() {
  mkdir -p "$HOME/.local/bin"; ln -sf "$SELF" "$HOME/.local/bin/lab"
  echo "Lien créé : ~/.local/bin/lab -> $SELF"
  case ":$PATH:" in *":$HOME/.local/bin:"*) echo "Tape : lab doctor" ;;
    *) echo "~/.local/bin n'est pas dans ton PATH : ajoute  export PATH=\"\$HOME/.local/bin:\$PATH\"  à ~/.bashrc, puis ouvre un nouveau terminal." ;; esac
}

current_mode() { cat "$STATE/mode" 2>/dev/null || echo normal; }
apply_mode() { # après un `up -d`, remet à l'arrêt ce que le mode « agents » doit garder arrêté
  [ "$(current_mode)" = agents ] || return 0
  local c; for c in "${AGENT_PAUSE[@]}"; do docker stop "$c" >/dev/null 2>&1 && echo "  (mode agents : $c reste arrêté)"; done
}

cmd_start() {
  need docker
  [ -f "$ROOT/ai-stack/.env" ] || die "ai-stack/.env manque : lance ./2-secrets.sh"
  local list=("${PROJECTS[@]}"); [ $# -gt 0 ] && list=("$@")
  for p in "${list[@]}"; do
    echo "→ $p"; dc "$p" up -d || echo "$c_ko échec pour $p"
  done
  apply_mode
  [ $# -eq 0 ] && echo "Ensuite : lab doctor"
  return 0
}
cmd_stop() {
  need docker
  local list=("${PROJECTS[@]}")
  if [ $# -gt 0 ]; then list=("$@")
  else local r=(); for ((i=${#list[@]}-1;i>=0;i--)); do r+=("${list[i]}"); done; list=("${r[@]}"); fi
  for p in "${list[@]}"; do echo "→ arrêt de $p"; dc "$p" stop; done
}

cmd_status() {
  need docker
  docker ps -a --format '{{.Names}}\t{{.Status}}' | sort | column -t -s $'\t'
  echo
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=name,pstate,power.draw,power.limit,temperature.gpu,utilization.gpu,memory.used,memory.total \
      --format=csv,noheader | sed 's/^/GPU : /'
  fi
  df -h --output=target,size,used,pcent / "$LAB_DATA_DIR" 2>/dev/null | sed 's/^/  /'
}

vram() { nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '{printf "%.1f Go utilisés / %.1f Go (libres : %.1f Go)", $1/1024, $2/1024, ($2-$1)/1024}'; }

cmd_mode() {
  need docker; local m="${1:-status}"; mkdir -p "$STATE"
  case "$m" in
    agents)
      echo "VRAM avant : $(vram)"
      local c; for c in "${AGENT_PAUSE[@]}"; do
        if [ -n "$(docker ps -q -f "name=^${c}$")" ]; then docker stop "$c" >/dev/null && echo "$c_ok $c arrêté"; else echo "· $c déjà arrêté"; fi
      done
      echo agents > "$STATE/mode"; sleep 3
      echo "VRAM après : $(vram)"
      echo "Mode agents actif. Ollama, Open WebUI, n8n, Qdrant, SearXNG, la supervision et Langfuse restent en marche (Langfuse observe les agents)."
      echo "Pour tout rétablir : lab mode normal" ;;
    images)
      [ -d "$ROOT/comfyui" ] || die "ComfyUI n'est pas installé (./4-comfyui.sh)"
      echo "VRAM avant : $(vram)"
      # 1. décharger les modèles Ollama de la VRAM (ils se rechargent seuls à la prochaine requête)
      local n unloaded=0
      while read -r n; do
        [ -n "$n" ] || continue
        if docker exec ollama ollama stop "$n" >/dev/null 2>&1; then echo "$c_ok modèle $n déchargé"; unloaded=1; else echo "$c_wa impossible de décharger $n"; fi
      done < <(docker exec ollama ollama ps 2>/dev/null | awk 'NR>1{print $1}')
      [ "$unloaded" = 1 ] || echo "· aucun modèle Ollama en VRAM"
      # 2. démarrer ComfyUI (kokoro et tika n'utilisent pas la VRAM : ils restent actifs)
      echo images > "$STATE/mode"
      echo "→ comfyui"; dc comfyui up -d || die "échec du démarrage de ComfyUI"
      echo -n "  attente de l'interface (jusqu'à 3 min) "
      local t=0 up=0
      while [ "$t" -lt 180 ]; do
        if curl -fsS -o /dev/null --max-time 2 http://127.0.0.1:8188/ 2>/dev/null; then up=1; break; fi
        echo -n "."; sleep 5; t=$((t+5))
      done; echo
      if [ "$up" = 1 ]; then echo "$c_ok ComfyUI répond : http://127.0.0.1:8188"
      else echo "$c_wa ComfyUI ne répond pas encore (le tout premier démarrage peut durer 10 min) : lab logs comfyui"; fi
      sleep 2; echo "VRAM après : $(vram)"
      echo "Mode images actif. Attention : toute requête à un modèle (Open WebUI, agent) le recharge dans la VRAM et prend la place de ComfyUI."
      echo "Pour revenir : lab mode normal (arrête ComfyUI)" ;;
    normal)
      local prev; prev="$(current_mode)"
      echo normal > "$STATE/mode"
      local c; for c in kokoro tika; do docker start "$c" >/dev/null 2>&1 && echo "$c_ok $c redémarré"; done
      if [ "$prev" = images ]; then
        docker stop comfyui >/dev/null 2>&1 && echo "$c_ok comfyui arrêté (VRAM libérée pour les modèles Ollama)"
        sleep 2; echo "VRAM : $(vram)"
      else
        echo "· ComfyUI reste dans son état actuel (lab start comfyui / lab stop comfyui)."
      fi
      echo "Mode normal." ;;
    status)
      echo "Mode : $(current_mode)"
      echo "VRAM : $(vram)"
      docker exec ollama ollama ps 2>/dev/null
      echo; echo "Conteneurs les plus gourmands en RAM :"
      printf '%-8s %-22s %-22s %s\n' "RAM %" "Conteneur" "Mémoire" "CPU"
      docker stats --no-stream --format '{{.MemPerc}}\t{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}' | sort -rn | head -8 | awk -F'\t' '{printf "%-8s %-22s %-22s %s\n",$1,$2,$3,$4}' ;;
    *) die "usage : lab mode agents|images|normal|status" ;;
  esac
}

