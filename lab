# Hermes Desktop graphical interface: a persistent "serve" container on 127.0.0.1:9119, same data as the
# command-line agent. docs/hermes-desktop.md. Shares data/state.db with ./5-hermes.sh / lab dev, so never both at once.
cmd_gateway() {
  need docker
  local HDIR="$ROOT/hermes" act="${1:-status}" URL="http://127.0.0.1:9119"
  case "$act" in
    start)
      docker network inspect hermes-net >/dev/null 2>&1 || die "hermes-net network missing: run ./3-demarrer.sh first"
      [ -z "$(docker ps -q --filter 'name=^hermes-(session|hermes-run)-')" ] \
        || die "an interactive Hermes session is running (./5-hermes.sh / lab dev); it shares data/state.db. Stop it before starting the gateway."
      [ -f "$HDIR/data/config.yaml" ] \
        || die "hermes/data/config.yaml missing: run ./5-hermes.sh MODEL once first (docs/hermes-desktop.md)."
      grep -q '^dashboard:' "$HDIR/data/config.yaml" \
        || die "no 'dashboard:' block in hermes/data/config.yaml: the dashboard refuses to bind on 0.0.0.0 without authentication (docs/hermes-desktop.md, section Authentication)."
      systemctl is-active --quiet ai-lab-isolation.service \
        || echo "$c_wa agent firewall inactive (lab isolation install): the gateway would have Internet access until it is enabled."
      printf 'HERMES_UID=%s\nHERMES_GID=%s\n' "$(id -u)" "$(id -g)" > "$HDIR/.env"
      # Optional local USB serial device, passed only when plugged in (same knob as ./5-hermes.sh).
      export HERMES_SERIAL="${HERMES_SERIAL:-/dev/ttyACM0}" HERMES_SERIAL_GID="${HERMES_SERIAL_GID:-20}"
      local GWF=(-f gateway.yml)
      if [ -e "$HERMES_SERIAL" ]; then GWF+=(-f serial-gw.yml); echo "   serial device $HERMES_SERIAL detected: passed to the gateway."; fi
      ( cd "$HDIR" && COMPOSE_IGNORE_ORPHANS=1 docker compose "${GWF[@]}" up -d )
      echo "$c_ok gateway started → $URL"
      echo "   From your PC: open the 9119 tunnel (lab client regenerates it), then point the Hermes Desktop app at $URL."
      echo "   $c_wa do NOT run ./5-hermes.sh / lab dev while it is up (shared data/state.db). Stop it: lab gateway stop"
      ;;
    stop)
      ( cd "$HDIR" && COMPOSE_IGNORE_ORPHANS=1 docker compose -f gateway.yml down )
      echo "$c_ok gateway stopped"
      ;;
    status)
      if [ -n "$(docker ps -q -f 'name=^hermes-gw$')" ]; then
        local code; code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$URL/" 2>/dev/null)"; [ -n "$code" ] || code=000
        echo "$c_ok gateway running — $URL (HTTP $code: 302/200/401 = answering)"
        [ -z "$(docker ps -q --filter 'name=^hermes-(session|hermes-run)-')" ] \
          || echo "$c_wa an interactive session is ALSO running: stop one (shared data/state.db)."
      else
        echo "· gateway stopped (start it: lab gateway start)"
      fi
      ;;
    *) die "usage: lab gateway start|stop|status" ;;
  esac
}

cmd_bureau() {
  local act="${1:-status}"; shift || true; local boot=0; [ "${1:-}" = "--boot" ] && boot=1
  local U=gnome-remote-desktop.service
  case "$act" in
    status)
      echo "system service: $(systemctl is-active $U 2>/dev/null)  (at boot: $(systemctl is-enabled $U 2>/dev/null))"
      echo "user service: $(systemctl --user is-active $U 2>/dev/null)"
      command -v nvidia-smi >/dev/null && nvidia-smi --query-gpu=pstate,power.draw --format=csv,noheader | sed 's/^/GPU: /' ;;
    off)
      if [ -z "${SSH_CONNECTION:-}" ]; then
        echo "$c_wa You do not seem to be in an SSH session. If you are INSIDE the remote desktop, it will be cut."
        read -r -p "Continue? [y/N] " r; [[ "$r" =~ ^[oOyY]$ ]] || exit 1
      fi
      sudo systemctl stop $U && echo "$c_ok remote desktop stopped (the GPU goes back to P8 in ≈ 20 s)"
      if [ $boot = 1 ]; then sudo systemctl disable $U && echo "$c_ok will no longer start at boot"; fi ;;
    on)
      sudo systemctl start $U && echo "$c_ok remote desktop started (≈ +100 W at idle)"
      if [ $boot = 1 ]; then sudo systemctl enable $U && echo "$c_ok will start at boot"; fi ;;
    *) die "usage: lab desktop on|off|status [--boot]" ;;
  esac
}

cmd_doctor() {
  need docker; local bad=0 warn=0
  ok() { echo "$c_ok $*"; }
  ko() { echo "$c_ko $*"; bad=$((bad+1)); }
  wa() { echo "$c_wa $*"; warn=$((warn+1)); }

  systemctl is-active --quiet docker && ok "Docker active" || ko "Docker inactive (sudo systemctl start docker)"
  local root; root="$(docker info -f '{{.DockerRootDir}}' 2>/dev/null)"
  case "$root" in "$LAB_DATA_DIR"/*) ok "Docker stores its data on $root" ;; *) wa "Docker stores on $root (expected: $LAB_DATA_DIR/docker, see ./8-stockage.sh)" ;; esac
  if mountpoint -q "$LAB_DATA_DIR"; then ok "$LAB_DATA_DIR mounted"
  elif [ -d "$LAB_DATA_DIR" ] && [ "${LAB_DATA_DIR}" != /data ]; then wa "$LAB_DATA_DIR is not a separate disk (normal on a single-disk machine)"
  else ko "$LAB_DATA_DIR NOT mounted (data disk missing? see LAB_DATA_DIR in lab.conf)"; fi

  local missing=() running expected=() mode; running="$(docker ps --format '{{.Names}}')"; mode="$(current_mode)"
  for c in "${EXPECTED[@]}"; do
    if [ "$mode" = agents ] && [[ " ${AGENT_PAUSE[*]} " == *" $c "* ]]; then continue; fi
    expected+=("$c")
  done
  for c in "${expected[@]}"; do grep -qx "$c" <<<"$running" || missing+=("$c"); done
  if [ ${#missing[@]} -eq 0 ]; then ok "${#expected[@]} expected containers running (mode: $mode)"; else ko "stopped or missing: ${missing[*]}"; fi
  if [ "$mode" = agents ]; then
    if [ "$(current_agent)" = hermes ]; then
      if openclaw_up; then wa "agents mode (hermes): OpenClaw is running too (lab mode agents hermes stops it)"; fi
    else
      [ -z "$(hermes_sessions)" ] || wa "agents mode (openclaw): a Hermes session is open (lab mode agents hermes to switch)"
    fi
  fi
  if [ -f "$ROOT/langfuse/app/docker-compose.yml" ]; then
    if [ -n "$(docker ps -q --filter label=com.docker.compose.service=langfuse-web)" ]; then ok "Langfuse running"; else ko "Langfuse installed but stopped (lab start langfuse)"; fi
  fi
  local unh; unh="$(docker ps --filter health=unhealthy --format '{{.Names}}')"
  if [ -z "$unh" ]; then ok "no \"unhealthy\" container"; else ko "unhealthy: $unh"; fi

  if command -v nvidia-smi >/dev/null; then
    local pl ps pw tp
    IFS=, read -r pl ps pw tp < <(nvidia-smi --query-gpu=power.limit,pstate,power.draw,temperature.gpu --format=csv,noheader,nounits)
    ps="${ps// /}"; pw="${pw// /}"
    ok "GPU: limit ${pl} W, $ps, $pw W, ${tp// /} °C"
    if [ "$ps" = P2 ] && awk "BEGIN{exit !($pw>80)}"; then
      # no warning if ComfyUI is running: an image generation explains P2 and the power draw
      [ -n "$(docker ps -q -f 'name=^comfyui$')" ] || docker exec ollama ollama ps 2>/dev/null | awk 'NR>1' | grep -q . || wa "GPU in P2 at $pw W with no model loaded: remote desktop active? (lab desktop off)"
    fi
  else wa "nvidia-smi not found"; fi
  if systemctl is-active --quiet gnome-remote-desktop.service; then wa "remote desktop active (≈ +100 W at idle)"; else ok "remote desktop off"; fi

  for m in / "$LAB_DATA_DIR"; do
    local u; u="$(df --output=pcent "$m" 2>/dev/null | tail -1 | tr -dc 0-9)"
    [ -z "$u" ] && continue
    if [ "$u" -lt 85 ]; then ok "disk $m: $u %"; else wa "disk $m: $u % (> 85 %)"; fi
  done

  local op; op="$(docker exec ollama ollama ps 2>/dev/null | awk 'NR>1')"
  if [ -n "$op" ]; then
    if grep -q 'CPU' <<<"$op"; then wa "a model spills over to the CPU (see: docker exec ollama ollama ps)"; else ok "loaded model(s) 100 % GPU"; fi
  fi

  # Agent isolation (docs/agent-isolation.md)
  local nint=0 n; for n in llm-net hermes-net obs-net; do [ "$(docker network inspect -f '{{.Internal}}' "$n" 2>/dev/null)" = true ] && nint=$((nint+1)); done
  [ "$nint" = 3 ] && ok "agent networks internal (llm-net, hermes-net, obs-net)" || ko "agent networks: $nint/3 internal (agents with Internet access; see docs/agent-isolation.md)"
  if systemctl is-active --quiet ai-lab-isolation.service; then ok "agent firewall active (lab isolation status)"
  else wa "agent firewall inactive: Hermes and OpenClaw can get out (lab isolation install)"; fi
  # Hermes sessions left running (terminal closed before the 5-hermes.sh fix, or forgotten session)
  local vieux=() cn st; while read -r cn st; do
    [ -n "$cn" ] || continue
    [ $(( $(date +%s) - $(date -d "$st" +%s 2>/dev/null || date +%s) )) -gt 43200 ] && vieux+=("${cn#/}")
  done < <(docker ps -q --filter 'name=^hermes-(session|hermes-run)-' | xargs -r docker inspect -f '{{.Name}} {{.State.StartedAt}}' 2>/dev/null)
  if [ ${#vieux[@]} -gt 0 ]; then wa "${#vieux[@]} Hermes session(s) running for more than 12 h: ${vieux[*]} (stop: docker rm -f NAME)"
  else ok "no forgotten Hermes session"; fi
  if command -v restic >/dev/null && [ -f "${BACKUP_PASSWORD_FILE:-$HOME/.config/aibeast-backup/password}" ]; then
    local l; if l="$("$ROOT/scripts/backup.sh" last 2>/dev/null)"; then ok "last backup: $l"; else wa "last backup: ${l:-not found} (lab backup run)"; fi
  else wa "backups not configured (lab backup init)"; fi

  echo
  if [ $bad -eq 0 ]; then echo "Result: all good ($warn remark(s))."; else echo "Result: $bad problem(s), $warn remark(s)."; fi
  [ $bad -eq 0 ]
}

snapshot_images() { # writes "project<TAB>reference<TAB>id" for each running container
  local f="$1"; : > "$f"
  for p in "${PROJECTS[@]}"; do
    docker ps --filter "label=com.docker.compose.project=$(basename "$(pdir "$p")")" --format '{{.Names}}' | while read -r n; do
      docker inspect -f '{{.Config.Image}}{{"\t"}}{{.Image}}' "$n" | awk -v p="$p" '{print p"\t"$0}'
    done
  done >> "$f"
}

cmd_update() {
  need docker; local nobackup=0; [ "${1:-}" = "--no-backup" ] && nobackup=1
  mkdir -p "$STATE"; local snap; snap="$STATE/images-$(date +%Y%m%d-%H%M%S).tsv"
  if [ $nobackup = 0 ] && command -v restic >/dev/null && [ -f "${BACKUP_PASSWORD_FILE:-$HOME/.config/aibeast-backup/password}" ]; then
    echo "→ backup before the update"; "$ROOT/scripts/backup.sh" run || die "backup failed: update cancelled (--no-backup to override)"
  else echo "$c_wa no backup before the update (not configured or --no-backup)"; fi
  snapshot_images "$snap"; ln -sf "$snap" "$STATE/latest.tsv"
  echo "$c_ok current images recorded: $snap ($(wc -l <"$snap") containers)"
  for p in "${PROJECTS[@]}"; do echo "→ pull $p"; dc "$p" pull --quiet || echo "$c_wa partial pull for $p"; done
  for p in "${PROJECTS[@]}"; do echo "→ up $p"; dc "$p" up -d; done
  apply_mode
  echo "→ waiting 30 s then checking"; sleep 30
  local changed=0 p ref old now
  while IFS=$'\t' read -r p ref old; do
    now="$(docker image inspect -f '{{.Id}}' "$ref" 2>/dev/null)"
    if [ -n "$now" ] && [ "$now" != "$old" ]; then echo "  updated: $ref"; changed=$((changed+1)); fi
  done < "$snap"
  echo "$changed image(s) changed."
  if ! cmd_doctor; then echo; echo "Problem detected. To go back: lab rollback"; exit 1; fi
  echo "Keep the old images until you are sure: do not run \"docker image prune\" before."
}

cmd_rollback() {
  need docker; local snap="$STATE/latest.tsv"; [ -f "$snap" ] || die "no recorded update ($STATE/latest.tsv)"
  echo "Going back to the images of: $(readlink -f "$snap")"
  local lost=0 p ref id
  while IFS=$'\t' read -r p ref id; do
    if docker image inspect "$id" >/dev/null 2>&1; then docker tag "$id" "$ref"; echo "  $ref ← ${id:7:12}"
    else echo "  $c_ko image $ref ${id:7:12} deleted: cannot go back"; lost=$((lost+1)); fi
  done < "$snap"
  for p in "${PROJECTS[@]}"; do dc "$p" up -d; done
  apply_mode
  [ $lost -gt 0 ] && echo "$c_wa $lost image(s) not found (prune?): see docs/lab.md"
  echo "Data (volumes) is not touched by an image rollback. If a database migrated to a newer format, restore it: docs/backups.md"
  cmd_doctor
}

c="${1:-help}"; shift || true
case "$c" in
  install) cmd_install ;;    start) cmd_start "$@" ;;      stop) cmd_stop "$@" ;;
  status) cmd_status ;;      doctor) cmd_doctor ;;         logs) cmd_logs "$@" ;;
  urls) cmd_urls ;;          models) cmd_models ;;         task-model) cmd_task_model "$@" ;;
  bench) cmd_bench "$@" ;;   gpu-limit) cmd_gpu_limit "$@" ;;  desktop|bureau) cmd_bureau "$@" ;;
  backup) cmd_backup "$@" ;; update) cmd_update "$@" ;;    rollback) cmd_rollback ;;
  mode) cmd_mode "$@" ;;     session) cmd_session "$@" ;;     panel) cmd_panel "$@" ;;     remote) cmd_remote "$@" ;;     dev) cmd_dev "$@" ;;     gateway) cmd_gateway "$@" ;;     config) cmd_config "$@" ;;
  tmux) cmd_tmux "$@" ;;     main-model) main_model ;;  client) cmd_client "$@" ;;  isolation) cmd_isolation "$@" ;;
  help|-h|--help|"") sed -n '2,30p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) echo "lab: unknown command \"$c\"" >&2; sed -n '2,30p' "$SELF" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
