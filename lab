#!/usr/bin/env bash
# lab: a single command to drive the AI machine (AiBeast). See docs/lab.md.
#
#   lab install                    creates the `lab` command (link in ~/.local/bin)
#   lab status                     containers, GPU, disks
#   lab doctor                     full health check (run it after a reboot)
#   lab start [project]            starts everything, in order (or one: ai-stack monitoring portail alerting comfyui langfuse)
#   lab stop [project]             stops (deletes nothing)
#   lab logs SERVICE [n]           logs of a container (followed live)
#   lab urls                       addresses of the interfaces
#   lab models                     installed and loaded models
#   lab task-model NAME            installs a small model for Open WebUI titles
#   lab bench [experiment] [...]   benchmark bench (no argument: list)
#   lab gpu-limit status|install [W]|remove    permanent GPU power limit
#   lab desktop on|off|status [--boot]         remote desktop (≈ 100 W; `lab bureau` also works)
#   lab client [--print]           generates the client PC's SSH config (tunnels + remote desktop) from lab.conf: docs/remote-access.md
#   lab isolation install|apply|status|test|remove|uninstall   cuts the agents (Hermes, OpenClaw) off from the Internet: docs/agent-isolation.md
#   lab backup init|run|list|check|restore|schedule    encrypted backups
#   lab update [--no-backup]       updates the images, records the old ones
#   lab rollback                   goes back to the images from before the last update
#   lab mode agents [hermes|openclaw]|images|normal|status   agents: only ONE agent active (default hermes); stops Open WebUI,
#                                          n8n, Qdrant, SearXNG, ComfyUI, Kokoro, Tika and the other agent; Ollama, monitoring,
#                                          portal and Langfuse keep running
#                                          images: unloads the Ollama models and starts ComfyUI; normal: restores
#   lab session list|close [NAME|--all]   open Hermes sessions: list, or close them (memory and history are kept)
#   lab config [list|set MODEL NAME]  stored main model; `lab tmux update|backup|doctor`: long action that survives a disconnection
#   lab panel install|token|status|logs|uninstall   web button panel (127.0.0.1:3011): docs/web-panel.md
#   lab remote add|show|link|list|test|remove   Hermes SSH access to a test machine (dedicated key): docs/hermes-ssh.md
#   lab dev new|list|start|review|check|merge|setup|ctx64   development with Hermes (code → test → review): docs/agent-development.md
#   lab gateway start|stop|status   Hermes Desktop graphical interface (remote gateway on 127.0.0.1:9119): docs/hermes-desktop.md
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(dirname "$SELF")"
STATE="$ROOT/.lab"

# Machine-specific configuration (optional): see lab.conf.example
[ -f "$ROOT/lab.conf" ] && . "$ROOT/lab.conf"
LAB_DATA_DIR="${LAB_DATA_DIR:-/data}"   # large volumes: Docker, backups, models
export LAB_DATA_DIR
PROJECTS=(ai-stack monitoring portail alerting)           # start order
[ -f "$ROOT/langfuse/app/docker-compose.yml" ] && PROJECTS+=(langfuse)   # only if installed (./6-langfuse.sh)
# Stopped by `lab mode agents` (dependents first; `lab mode normal` restarts them in reverse order, except ComfyUI).
# Kept: Ollama, monitoring and alerts, portal, Langfuse (observes Hermes).
AGENT_PAUSE=(comfyui open-webui n8n kokoro tika searxng qdrant postgres-n8n)
OPENCLAW_CT="${OPENCLAW_CT:-openclaw-openclaw-gateway-1}"   # OpenClaw gateway (see openclaw/install.sh)
EXPECTED=(ollama open-webui n8n qdrant postgres-n8n searxng kokoro tika
          prometheus grafana node-exporter gpu-exporter
          homepage ntfy alertmanager alertmanager-ntfy blackbox-exporter)

c_ok=$'\e[32m✓\e[0m'; c_ko=$'\e[31m✗\e[0m'; c_wa=$'\e[33m!\e[0m'
die()  { echo "lab: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is missing"; }

pdir() { # pdir PROJECT -> compose folder
  case "$1" in
    langfuse) echo "$ROOT/langfuse/app" ;;
    ai-stack|monitoring|portail|alerting|comfyui|hermes) echo "$ROOT/$1" ;;
    *) die "unknown project: $1 (ai-stack monitoring portail alerting comfyui langfuse)" ;;
  esac
}
dc() { local p="$1"; shift; local d; d="$(pdir "$p")"; [ -d "$d" ] || die "missing folder: $d"; (cd "$d" && docker compose "$@"); }

env_set() { # env_set FILE KEY VALUE: replaces or adds KEY=VALUE without touching the rest
  python3 - "$1" "$2" "$3" <<'PY'
import sys,re
f,k,v=sys.argv[1:4]
try: lines=open(f).read().splitlines()
except FileNotFoundError: lines=[]
out=[];done=False
for l in lines:
    if re.match(rf"^\s*{re.escape(k)}\s*=",l): out.append(f"{k}={v}"); done=True
    else: out.append(l)
if not done: out.append(f"{k}={v}")
open(f,"w").write("\n".join(out)+"\n")
PY
}

cmd_install() {
  mkdir -p "$HOME/.local/bin"; ln -sf "$SELF" "$HOME/.local/bin/lab"
  echo "Link created: ~/.local/bin/lab -> $SELF"
  case ":$PATH:" in *":$HOME/.local/bin:"*) echo "Type: lab doctor" ;;
    *) echo "~/.local/bin is not in your PATH: add  export PATH=\"\$HOME/.local/bin:\$PATH\"  to ~/.bashrc, then open a new terminal." ;; esac
}

current_mode() { cat "$STATE/mode" 2>/dev/null || echo normal; }
current_agent() { cat "$STATE/agent" 2>/dev/null || echo hermes; }   # agent kept active in agents mode
hermes_sessions() { docker ps --format '{{.Names}}' 2>/dev/null | grep '^hermes-session-' || true; }
openclaw_up() { [ -n "$(docker ps -q -f "name=^${OPENCLAW_CT}$" 2>/dev/null)" ]; }
apply_mode() { # after an `up -d`, stops again what "agents" mode must keep stopped
  [ "$(current_mode)" = agents ] || return 0
  local c; for c in "${AGENT_PAUSE[@]}"; do docker stop "$c" >/dev/null 2>&1 && echo "  (agents mode: $c stays stopped)"; done
  if [ "$(current_agent)" = hermes ] && openclaw_up; then
    docker stop "$OPENCLAW_CT" >/dev/null 2>&1 && { touch "$STATE/openclaw-paused"; echo "  (agents mode, agent hermes: OpenClaw stays stopped)"; }
  fi
}

cmd_start() {
  need docker
  [ -f "$ROOT/ai-stack/.env" ] || die "ai-stack/.env is missing: run ./2-secrets.sh"
  local list=("${PROJECTS[@]}"); [ $# -gt 0 ] && list=("$@")
  for p in "${list[@]}"; do
    echo "→ $p"; dc "$p" up -d || echo "$c_ko failed for $p"
  done
  apply_mode
  [ $# -eq 0 ] && echo "Next: lab doctor"
  return 0
}
cmd_stop() {
  need docker
  local list=("${PROJECTS[@]}")
  if [ $# -gt 0 ]; then list=("$@")
  else local r=(); for ((i=${#list[@]}-1;i>=0;i--)); do r+=("${list[i]}"); done; list=("${r[@]}"); fi
  for p in "${list[@]}"; do echo "→ stopping $p"; dc "$p" stop; done
}

cmd_status() {
  need docker
  docker ps -a --format '{{.Names}}\t{{.Status}}' | sort | column -t -s $'\t'
  echo
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=name,pstate,power.draw,power.limit,temperature.gpu,utilization.gpu,memory.used,memory.total \
      --format=csv,noheader | sed 's/^/GPU: /'
  fi
  df -h --output=target,size,used,pcent / "$LAB_DATA_DIR" 2>/dev/null | sed 's/^/  /'
}

vram() { nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null | awk -F', ' '{printf "%.1f GB used / %.1f GB (free: %.1f GB)", $1/1024, $2/1024, ($2-$1)/1024}'; }

cmd_mode() {
  need docker; local m="${1:-status}"; mkdir -p "$STATE"
  case "$m" in
    agents)
      local ag="${2:-hermes}" c
      case "$ag" in hermes|openclaw) ;; *) die "usage: lab mode agents [hermes|openclaw]   (only ONE agent stays active)";; esac
      if [ "$ag" = openclaw ]; then
        local sess; sess="$(hermes_sessions)"
        [ -z "$sess" ] || die "Hermes session(s) still open: $(echo $sess). Close them first (Ctrl+D in Hermes); nothing was changed."
        docker inspect "$OPENCLAW_CT" >/dev/null 2>&1 || die "OpenClaw is not installed (container $OPENCLAW_CT not found: openclaw/install.sh)"
      fi
      echo "VRAM before: $(vram)"
      for c in "${AGENT_PAUSE[@]}"; do
        if [ -n "$(docker ps -q -f "name=^${c}$")" ]; then docker stop "$c" >/dev/null && echo "$c_ok $c stopped"; else echo "· $c already stopped"; fi
      done
      echo agents > "$STATE/mode"; echo "$ag" > "$STATE/agent"
      if [ "$ag" = hermes ]; then
        if openclaw_up; then docker stop "$OPENCLAW_CT" >/dev/null && touch "$STATE/openclaw-paused" && echo "$c_ok OpenClaw stopped"; else echo "· OpenClaw already stopped"; fi
      else
        if openclaw_up; then echo "· OpenClaw already running"; else docker start "$OPENCLAW_CT" >/dev/null && echo "$c_ok OpenClaw started"; fi
        rm -f "$STATE/openclaw-paused"
      fi
      sleep 3
      echo "VRAM after: $(vram)"
      echo "Agents mode active, agent: $ag. Kept: Ollama, monitoring and alerts, portal, Langfuse."
      [ "$ag" = openclaw ] && echo "Hermes sessions are refused in this mode (./5-hermes.sh, lab dev start): lab mode agents hermes to switch."
      echo "To restore everything: lab mode normal" ;;
    images)
      [ -d "$ROOT/comfyui" ] || die "ComfyUI is not installed (./4-comfyui.sh)"
      echo "VRAM before: $(vram)"
      # 1. unload the Ollama models from VRAM (they reload by themselves at the next request)
      local n unloaded=0
      while read -r n; do
        [ -n "$n" ] || continue
        if docker exec ollama ollama stop "$n" >/dev/null 2>&1; then echo "$c_ok model $n unloaded"; unloaded=1; else echo "$c_wa could not unload $n"; fi
      done < <(docker exec ollama ollama ps 2>/dev/null | awk 'NR>1{print $1}')
      [ "$unloaded" = 1 ] || echo "· no Ollama model in VRAM"
      # 2. start ComfyUI (kokoro and tika do not use VRAM: they stay active)
      echo images > "$STATE/mode"
      echo "→ comfyui"; dc comfyui up -d || die "ComfyUI failed to start"
      echo -n "  waiting for the interface (up to 3 min) "
      local t=0 up=0
      while [ "$t" -lt 180 ]; do
        if curl -fsS -o /dev/null --max-time 2 http://127.0.0.1:8188/ 2>/dev/null; then up=1; break; fi
        echo -n "."; sleep 5; t=$((t+5))
      done; echo
      if [ "$up" = 1 ]; then echo "$c_ok ComfyUI answers: http://127.0.0.1:8188"
      else echo "$c_wa ComfyUI is not answering yet (the very first start can take 10 min): lab logs comfyui"; fi
      sleep 2; echo "VRAM after: $(vram)"
      echo "Images mode active. Careful: any request to a model (Open WebUI, agent) reloads it into VRAM and takes ComfyUI's place."
      echo "To go back: lab mode normal (stops ComfyUI)" ;;
    normal)
      local prev; prev="$(current_mode)"
      echo normal > "$STATE/mode"
      local c i; for ((i=${#AGENT_PAUSE[@]}-1;i>=0;i--)); do   # reverse order: databases first; ComfyUI is not restarted
        c="${AGENT_PAUSE[i]}"; [ "$c" = comfyui ] && continue
        docker start "$c" >/dev/null 2>&1 && echo "$c_ok $c restarted"
      done
      if [ -f "$STATE/openclaw-paused" ]; then
        docker start "$OPENCLAW_CT" >/dev/null 2>&1 && echo "$c_ok OpenClaw restarted"; rm -f "$STATE/openclaw-paused"
      fi
      if [ "$prev" = images ]; then
        docker stop comfyui >/dev/null 2>&1 && echo "$c_ok comfyui stopped (VRAM freed for the Ollama models)"
        sleep 2; echo "VRAM: $(vram)"
      else
        echo "· ComfyUI stays in its current state (lab start comfyui / lab stop comfyui)."
      fi
      echo "Normal mode." ;;
    status)
      echo "Mode: $(current_mode)$([ "$(current_mode)" = agents ] && echo " (agent: $(current_agent))")"
      echo "VRAM: $(vram)"
      docker exec ollama ollama ps 2>/dev/null
      echo; echo "Containers using the most RAM:"
      printf '%-8s %-22s %-22s %s\n' "RAM %" "Container" "Memory" "CPU"
      docker stats --no-stream --format '{{.MemPerc}}\t{{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}' | sort -rn | head -8 | awk -F'\t' '{printf "%-8s %-22s %-22s %s\n",$1,$2,$3,$4}' ;;
    *) die "usage: lab mode agents [hermes|openclaw]|images|normal|status" ;;
  esac
}

cmd_session() { # Hermes sessions = containers hermes-session-... (see 5-hermes.sh)
  need docker; local a="${1:-list}"; shift || true
  local sess; sess="$(hermes_sessions)"
  case "$a" in
    list) if [ -z "$sess" ]; then echo "No Hermes session open."; else docker ps --filter name=hermes-session --format 'table {{.Names}}\t{{.Status}}\t{{.CreatedAt}}'; fi ;;
    close)
      local target="${1:-}" c
      [ -n "$sess" ] || { echo "No Hermes session open."; return 0; }
      case "$target" in
        ""|--all) ;;
        *) [[ "$target" =~ ^hermes-session-[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || die "invalid session name: $target (lab session list)"
           grep -qx "$target" <<<"$sess" || die "no such session: $target (lab session list)"
           sess="$target" ;;
      esac
      if [ -z "$target" ] && [ "$(wc -l <<<"$sess")" -gt 1 ]; then
        echo "$c_wa Several sessions are open: lab session close NAME, or --all"; echo "$sess"; return 1
      fi
      for c in $sess; do docker rm -f "$c" >/dev/null && echo "$c_ok $c closed"; done
      echo "Hermes's memory and history (hermes/data) are kept; project files too." ;;
    *) die "usage: lab session list|close [NAME|--all]" ;;
  esac
}

