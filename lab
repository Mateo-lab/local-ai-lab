cmd_logs() { need docker; local s="${1:?usage: lab logs SERVICE [lines]}"; docker logs -f --tail "${2:-100}" "$s"; }

cmd_models() { need docker; echo "Installed:"; docker exec ollama ollama list; echo; echo "Loaded in VRAM:"; docker exec ollama ollama ps; }

cmd_task_model() {
  need docker; local m="${1:?usage: lab task-model NAME   (a model with 1 to 4 billion parameters)}"
  echo "→ downloading $m"; docker exec ollama ollama pull "$m" || die "download failed: exact model name?"
  env_set "$ROOT/ai-stack/.env" OLLAMA_MAX_LOADED_MODELS 2
  env_set "$ROOT/ai-stack/.env" OWUI_TASK_MODEL "$m"
  echo "→ restarting Ollama and Open WebUI (the model in memory will be reloaded at the next message)"
  dc ai-stack up -d ollama open-webui
  cat <<MSG
$c_ok ai-stack/.env updated (OLLAMA_MAX_LOADED_MODELS=2, OWUI_TASK_MODEL=$m).
TO DO in Open WebUI (existing settings are kept in its database):
  Admin → Settings → Interface → Task Model → $m
Then check: docker exec ollama ollama ps   (two lines, all 100% GPU)
MSG
}

cfg_get() { [ -f "$STATE/config" ] && awk -F= -v k="$1" '$1==k{sub(/^[^=]*=/,""); print; exit}' "$STATE/config"; }
cfg_set() { mkdir -p "$STATE"; env_set "$STATE/config" "$1" "$2"; }

# Main model: LAB_MODEL, otherwise `lab config set MODEL …`, otherwise the LARGEST installed model (excluding embeddings and
# Open WebUI's small task model). The first one in `ollama list` is often that small model: do not rely on it.
main_model() {
  [ -n "${LAB_MODEL:-}" ] && { echo "$LAB_MODEL"; return; }
  local c; c="$(cfg_get MODEL)"; [ -n "$c" ] && { echo "$c"; return; }
  local task; task="$(awk -F= '$1=="OWUI_TASK_MODEL"{print $2}' "$ROOT/ai-stack/.env" 2>/dev/null)"
  docker exec ollama ollama list 2>/dev/null | awk -v task="${task:-__none__}" 'NR>1 && $1 !~ /embed|nomic/ && $1 != task {
      u=$4; v=$3+0; if (u=="GB") v*=1024; else if (u=="KB") v/=1024; else if (u!="MB") next; print v, ($1 ~ /-64k$/ ? 1 : 0), $1 }' \
    | sort -k1,1nr -k2,2nr | head -1 | awk '{print $3}'
}
default_model() { main_model; }

cmd_config() { # lab config [list | get KEY | set KEY VALUE | unset KEY]
  local a="${1:-list}"; mkdir -p "$STATE"
  case "$a" in
    list) echo "Stored settings (.lab/config):"; [ -s "$STATE/config" ] && sed 's/^/  /' "$STATE/config" || echo "  (none)"
          echo "Main model used now: $(main_model)  (LAB_MODEL, then the MODEL setting, then the largest installed model)" ;;
    get)  cfg_get "${2:?usage: lab config get KEY}" ;;
    set)  local k="${2:?usage: lab config set MODEL MODEL_NAME}" v="${3:?missing value}"
          case "$k" in MODEL) docker exec ollama ollama list 2>/dev/null | awk 'NR>1{print $1}' | grep -qx "$v" \
                               || die "model \"$v\" not found in Ollama (lab models)";; *) die "unknown setting: $k (MODEL)";; esac
          cfg_set "$k" "$v"; echo "$c_ok $k=$v stored. Used by lab bench, lab dev start… (Open WebUI keeps its own default model: set it in its interface)" ;;
    unset) [ -f "$STATE/config" ] && sed -i "/^${2:?usage: lab config unset KEY}=/d" "$STATE/config"; echo "$c_ok ${2} removed" ;;
    *) die "usage: lab config list|get KEY|set MODEL NAME|unset KEY" ;;
  esac
}

# Runs a long action in a named tmux session (survives an SSH disconnection; reattaches if it already exists).
cmd_tmux() {
  local a="${1:?usage: lab tmux update|backup|doctor}"; need tmux
  case "$a" in update|backup|doctor) ;; *) die "unknown action: $a (update backup doctor)";; esac
  local arg="" ; [ "$a" = backup ] && arg=" run"
  exec tmux new-session -A -s "lab-$a" "$SELF $a$arg; echo; read -r -p 'Done. Press Enter to close. ' _"
}

cmd_bench() {
  if [ $# -eq 0 ]; then exec "$ROOT/7-bench.sh" list; fi
  local name="$1"; shift
  case "$name" in check|list|report) exec "$ROOT/7-bench.sh" "$name" "$@" ;; esac
  local has=""; for a in "$@"; do [ "$a" = "--model" ] && has=set; done
  if [ -z "$has" ]; then
    local m; m="$(default_model)"; [ -n "$m" ] || die "no model found: give --model NAME or export LAB_MODEL"
    echo "Model: $m  (change with --model NAME or LAB_MODEL=NAME)"
    set -- --model "$m" "$@"
  fi
  exec "$ROOT/7-bench.sh" run "$name" "$@"
}

# Web panel (buttons): systemd user service, listens on 127.0.0.1:3011 only.
cmd_panel() {
  local unit="$HOME/.config/systemd/user/aibeast-panel.service" tokf="$HOME/.config/aibeast-panel/token"
  case "${1:-status}" in
    install)
      need systemctl; need python3
      mkdir -p "$(dirname "$unit")"
      cat > "$unit" <<UNIT
[Unit]
Description=AiBeast panel (buttons)

[Service]
ExecStart=/usr/bin/env python3 $ROOT/panel/panel.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
UNIT
      systemctl --user daemon-reload && systemctl --user enable --now aibeast-panel.service
      loginctl enable-linger "$USER" 2>/dev/null || echo "$c_wa linger not enabled: the panel will only start after your first login (sudo loginctl enable-linger $USER)"
      sleep 1; cmd_panel token ;;
    token)
      [ -f "$tokf" ] || die "no token: lab panel install"
      echo "Open this address once in your PC's browser (SSH tunnel active):"
      echo "  http://127.0.0.1:3011/login?t=$(cat "$tokf")" ;;
    status) systemctl --user is-active aibeast-panel.service 2>&1 || true ;;
    logs) exec journalctl --user -u aibeast-panel.service -n "${2:-50}" --no-pager ;;
    restart) systemctl --user restart aibeast-panel.service && echo "$c_ok restarted" ;;
    uninstall) systemctl --user disable --now aibeast-panel.service 2>/dev/null; rm -f "$unit"; systemctl --user daemon-reload; echo "$c_ok uninstalled (the token stays in $tokf)" ;;
    *) die "usage: lab panel install|token|status|logs|restart|uninstall" ;;
  esac
}

