# Copy to .env to change the default values (optional).
# Listening address of the ntfy port: 127.0.0.1 = this machine only (default, the safest).
# To receive notifications on your phone through the VPN, set the AI machine's VPN/network IP and read docs/alerts.md.
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://127.0.0.1:2586
NTFY_AUTH_DEFAULT_ACCESS=read-write
