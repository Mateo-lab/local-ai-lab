# Copier en .env pour changer les valeurs par défaut (facultatif).
# Adresse d'écoute du port ntfy : 127.0.0.1 = machine seulement (défaut, le plus sûr).
# Pour recevoir les notifications sur ton téléphone via le VPN, mets l'IP d'AiBeast sur le VPN/réseau et lis docs/alerts.md.
NTFY_BIND=127.0.0.1
NTFY_BASE_URL=http://127.0.0.1:2586
NTFY_AUTH_DEFAULT_ACCESS=read-write
