# Copied to hermes/data/config.yaml by ../5-hermes.sh (the model is replaced).
# Hermes requires at least a 64,000-token context: Ollama must serve it
# (OLLAMA_CONTEXT_LENGTH=65536 in ai-stack/.env, or the -64k variant made by `lab dev ctx64`);
# check with `docker exec ollama ollama ps`.
model:
  default: __MODEL__
  provider: custom
  base_url: http://ollama:11434/v1
  context_length: 64000
# Sub-agents one at a time: Ollama handles ONE request at a time (measured), sub-agents in
# parallel would queue and Hermes abandons a sub-agent with no progress for 450 s.
delegation:
  max_concurrent_children: 1
  max_spawn_depth: 1
  max_iterations: 60
