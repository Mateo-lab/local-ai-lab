# Copier en .env puis remplir :  cp .env.example .env
# Générer chaque secret avec :   openssl rand -hex 32

WEBUI_SECRET_KEY=
N8N_ENCRYPTION_KEY=
# Mot de passe de la base PostgreSQL de n8n (lettres/chiffres : openssl rand -hex 24)
POSTGRES_N8N_PASSWORD=
# Clé interne de SearXNG (générée par ../2-secrets.sh)
SEARXNG_SECRET=

# --- Réglages Ollama (RTX 3090, 24 Go de VRAM) ---
# 32768 est le choix prudent. OpenClaw recommande >= 65536 : essaie 65536
# avec le cache KV en q8_0, puis vérifie avec `docker exec ollama ollama ps`
# que le modèle est bien à 100 % GPU (sinon redescends le contexte ou le modèle).
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
# Nombre de modèles gardés en VRAM en même temps. 2 si tu utilises un petit « modèle de tâches » (docs/open-webui.md)
OLLAMA_MAX_LOADED_MODELS=1

# --- Open WebUI ---
# Mettre à false une fois ton compte admin créé
ENABLE_SIGNUP=true
# Petit modèle pour titres/étiquettes (rempli par `lab task-model NOM`). Lu au 1er démarrage d'Open WebUI seulement.
OWUI_TASK_MODEL=

# --- n8n ---
# Si tu y accèdes via Tailscale (ex. https://machine.tailnet.ts.net), mets cette URL ici
N8N_WEBHOOK_URL=http://localhost:5678/
# false = nécessaire pour un accès en http hors localhost ; true si tu passes en https
N8N_SECURE_COOKIE=false

# --- Voix (Kokoro) ---
# Voix Kokoro (cette version n'a que des voix anglaises : af_*, am_*, bf_*, bm_*)
KOKORO_VOICE=af_bella
