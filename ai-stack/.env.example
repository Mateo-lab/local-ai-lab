# Copy to .env then fill in:  cp .env.example .env   (../2-secrets.sh does it for you)
# Generate each secret with:  openssl rand -hex 32

WEBUI_SECRET_KEY=
N8N_ENCRYPTION_KEY=
# Password of n8n's PostgreSQL database (letters/digits: openssl rand -hex 24)
POSTGRES_N8N_PASSWORD=
# SearXNG's internal key (generated by ../2-secrets.sh)
SEARXNG_SECRET=

# --- Ollama settings (RTX 3090, 24 GB of VRAM) ---
# 32768 is the cautious choice. OpenClaw recommends >= 65536: try 65536
# with the KV cache in q8_0, then check with `docker exec ollama ollama ps`
# that the model is 100 % GPU (otherwise lower the context or the model).
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
# Number of models kept in VRAM at the same time. 2 if you use a small "task model" (docs/open-webui.md)
OLLAMA_MAX_LOADED_MODELS=1

# --- Open WebUI ---
# Set to false once your admin account is created
ENABLE_SIGNUP=true
# Small model for titles/tags (filled in by `lab task-model NAME`). Only read at Open WebUI's 1st start.
OWUI_TASK_MODEL=
# Interface language at the 1st start (en, fr, de, es…); afterwards: Settings > General
OPEN_WEBUI_LOCALE=en

# --- n8n ---
# Time zone of the schedules (IANA name)
N8N_TIMEZONE=Europe/Brussels
# If you reach it through Tailscale (e.g. https://machine.tailnet.ts.net), put that URL here
N8N_WEBHOOK_URL=http://localhost:5678/
# false = needed for http access outside localhost; true if you switch to https
N8N_SECURE_COOKIE=false

# --- Voice (Kokoro) ---
# Kokoro voice (mostly English voices: af_*, am_*, bf_*, bm_*; French: ff_siwis)
KOKORO_VOICE=af_bella
